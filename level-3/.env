# System Data Source Options: digital_twin, csv, serial
DATA_SOURCE=digital_twin

# Redpanda Event Bus
REDPANDA_BROKER=aether_redpanda:9092

# Database Settings
POSTGRES_USER=aether
POSTGRES_PASSWORD=aetherpass
POSTGRES_DB=telemetry_db

# Hardware Serial Settings (Used when DATA_SOURCE=serial)
SERIAL_PORT=COM4
BAUD_RATE=115200

# Switch from simulation to real hardware:
DATA_SOURCE=serial
SERIAL_PORT=COM4
BAUD_RATE=115200